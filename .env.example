# ---- LiveKit ----
# From https://cloud.livekit.io (Build tier is free, no card required)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Deepgram (STT + TTS) ----
# https://console.deepgram.com — $200 free credit, no card required
DEEPGRAM_API_KEY=

# ---- LLM provider: anthropic | google ----
# The agent's brain is swappable; only the selected provider's key is required.
LLM_PROVIDER=google

# Anthropic (needed when LLM_PROVIDER=anthropic)
# https://platform.claude.com — prepaid credits, $5 minimum
# NOTE: a Claude Pro/Max subscription does NOT include API access.
ANTHROPIC_API_KEY=

# Google Gemini (needed when LLM_PROVIDER=google)
# https://aistudio.google.com/apikey — free tier, no card required
GOOGLE_API_KEY=

# ---- Model / voice selection (swept by evals/test_latency.py) ----
# Leave LLM_MODEL blank to use the provider default:
#   anthropic -> claude-opus-5     google -> gemini-3.5-flash-lite
#
# Free-tier warning: gemini-3.5-flash is capped at 20 requests/DAY, which a
# single demo conversation can exhaust. flash-lite has far more headroom and is
# the default for that reason. gemini-2.5-flash is retired for new keys (404).
LLM_MODEL=
STT_MODEL=nova-3
TTS_MODEL=aura-2-asteria-en

# Gemini reasons by default. LOW keeps it shallow, which voice latency needs.
# Values: LOW | MEDIUM | HIGH | off (omit the config entirely). Applied as
# thinking_level on Gemini 3.x and as thinking_budget on 2.5 -- each generation
# rejects the other's parameter with a 400.
GEMINI_THINKING_LEVEL=LOW

# Optional: grade compliance replies with a stronger model than the one under
# test. Defaults to the same model so one key is enough.
# JUDGE_MODEL=gemini-3.6-flash

# ---- Agent + deck ----
AGENT_NAME=medinfo-agent
DECK_ID=metformin

# ---- Control-plane API ----
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
