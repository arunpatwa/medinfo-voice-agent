# ---- LiveKit ----
# From https://cloud.livekit.io (Build tier is free, no card required)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Deepgram (STT + TTS) ----
# https://console.deepgram.com — $200 free credit, no card required
DEEPGRAM_API_KEY=

# ---- LLM provider: anthropic | google ----
# The agent's brain is swappable; only the selected provider's key is required.
LLM_PROVIDER=google

# Anthropic (needed when LLM_PROVIDER=anthropic)
# https://platform.claude.com — prepaid credits, $5 minimum
# NOTE: a Claude Pro/Max subscription does NOT include API access.
ANTHROPIC_API_KEY=

# Google Gemini (needed when LLM_PROVIDER=google)
# https://aistudio.google.com/apikey — free tier, no card required
GOOGLE_API_KEY=

# ---- Model / voice selection (swept by evals/test_latency.py) ----
# Leave LLM_MODEL blank to use the provider default:
#   anthropic -> claude-opus-5     google -> gemini-2.5-flash
LLM_MODEL=
STT_MODEL=nova-3
TTS_MODEL=aura-2-asteria-en

# Gemini 2.5 thinks by default. 0 disables it, which voice latency needs.
GEMINI_THINKING_BUDGET=0

# ---- Agent + deck ----
AGENT_NAME=medinfo-agent
DECK_ID=metformin

# ---- Control-plane API ----
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
